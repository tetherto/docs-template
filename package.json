{
  "name": "@tether/docs-site",
  "version": "0.1.0",
  "description": "Official documentation and single source of truth for DOCS",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-takumi-og.mts",
    "build": "next build && npx @vahor/next-broken-links",
    "build:static": "next build && npx @vahor/next-broken-links",
    "build:og": "tsx scripts/generate-takumi-og.mts",
    "dev": "next dev --turbo -p 3001",
    "start": "next start",
    "serve": "serve out -p 8080",
    "postinstall": "fumadocs-mdx",
    "check-links": "node scripts/check-links.js"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "^1.4.10",
    "@tetherto/docs-seo-next": "1.0.0",
    "@tetherto/docs-seo-og": "1.0.0",
    "@tetherto/docs-seo-schema": "1.0.0",
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@ai-sdk/react": "^2.0.118",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@inkeep/cxkit-react": "^0.5.111",
    "@orama/orama": "^3.1.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-presence": "^1.1.5",
    "ai": "^5.0.116",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.3",
    "fumadocs-core": "^16.3.2",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.3.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.16.27",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.12.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "26.2.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vahor/next-broken-links": "^0.4.1",
    "glob": "^11.0.3",
    "postcss": "^8.5.6",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-validate-links": "^13.1.0",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.13",
    "typedoc": "^0.28.17",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "unified": "^11.0.2",
    "unist-util-visit": "^5.0.0"
  }
}
