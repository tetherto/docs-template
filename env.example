# Copy to `.env.local` for local development (Next.js loads it automatically).
# https://nextjs.org/docs/app/guides/environment-variables

# -----------------------------------------------------------------------------
# Required for production — SEO (canonical URLs, Open Graph / Twitter absolutes)
# Optional locally: defaults to http://localhost:3001 in src/lib/seo-config.ts
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DOCS_ORIGIN=https://your-docs-host.example

# -----------------------------------------------------------------------------
# Optional — Inkeep (only if you replace Fumadocs default search + want Inkeep chat)
# When unset, the app uses Fumadocs built-in search (e.g. Orama) and omits Inkeep UI.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_INKEEP_API_KEY=

# -----------------------------------------------------------------------------
# Optional — QVAC docs search service (@tetherto/docs-search)
# The service's origin. When set, the search box asks it (semantic search over this
# site's index) and uses the built-in search if it fails; it takes precedence over
# Inkeep for search, and Inkeep (if keyed) becomes the "Ask AI" button.
# The service must list this site's origin in its QVAC_ALLOWED_ORIGINS.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_QVAC_API_URL=https://docs-search.example.com
# This site's GitHub repo, written into /docs-search.json (the service's index is built from it)
# NEXT_PUBLIC_DOCS_REPO=your-org/your-docs-repo

# -----------------------------------------------------------------------------
# Optional — SEO (@tether/docs-seo-*)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_DOCS_PUBLISHER_LOGO_URL=https://your-cdn.example/logo.png

# Skip Takumi OG prebuild; metadata uses staticOgImagePath / public/og-default.png
# SKIP_OG_BUILD=1

# Prebuild only (tsx scripts/generate-takumi-og.mts — not loaded from .env.local unless exported)
# DOCS_OG_SITE_LABEL=Tether
# DOCS_OG_CONCURRENCY=3

# Suppress only the [@tether/docs-seo] warnings for fields that have sensible
# auto-generated / inferred defaults (ogImage, schemaType, lastModified).
# Keeps `description` and `docType` warnings live. Recommended when you use the
# Takumi OG prebuild and the fumadocs-mdx `lastModified` plugin.
# DOCS_SEO_QUIET_GENERATED=1

# Heavy hammer: silence ALL [@tether/docs-seo] warnings, including the required
# `description` warning. Use sparingly.
# DOCS_SEO_SILENT=1
